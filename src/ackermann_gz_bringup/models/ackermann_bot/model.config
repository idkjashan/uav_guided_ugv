<?xml version="1.0"?>
<model>
  <name>ackermann_bot</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>ackermann_gz_bringup</name>
  </author>

  <description>
    A basic 4-wheel Ackermann-steered vehicle for Gazebo Harmonic (gz-sim),
    driven with the built-in AckermannSteering system plugin, with an ArUco
    fiducial marker (DICT_4X4_50, id 0) mounted on its roof.
  </description>
</model>
