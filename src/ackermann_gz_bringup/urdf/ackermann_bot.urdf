<?xml version="1.0"?>
<robot name="ackermann_bot">

  <!-- Base footprint at ground level -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.32" rpy="0 0 0"/>
  </joint>

  <!-- Chassis Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="0.5208" ixy="0.0" ixz="0.0"
               iyy="1.7708" iyz="0.0"
               izz="2.0833"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.6 0.25"/>
      </geometry>
      <material name="chassis_blue">
        <color rgba="0.15 0.35 0.65 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.6 0.25"/>
      </geometry>
    </collision>
  </link>

  <!-- Wheels Materials -->
  <material name="wheel_dark_grey">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="marker_white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>

  <!-- Front Left Wheel -->
  <link name="front_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.00945" ixy="0.0" ixz="0.0"
               iyy="0.0169" iyz="0.0"
               izz="0.00945"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.09"/>
      </geometry>
      <material name="wheel_dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.09"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.45 0.35 -0.17" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Front Right Wheel -->
  <link name="front_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.00945" ixy="0.0" ixz="0.0"
               iyy="0.0169" iyz="0.0"
               izz="0.00945"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.09"/>
      </geometry>
      <material name="wheel_dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.09"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.45 -0.35 -0.17" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Rear Left Wheel -->
  <link name="rear_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.00945" ixy="0.0" ixz="0.0"
               iyy="0.0169" iyz="0.0"
               izz="0.00945"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.09"/>
      </geometry>
      <material name="wheel_dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.09"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.45 0.35 -0.17" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- Rear Right Wheel -->
  <link name="rear_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.00945" ixy="0.0" ixz="0.0"
               iyy="0.0169" iyz="0.0"
               izz="0.00945"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.09"/>
      </geometry>
      <material name="wheel_dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.09"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.45 -0.35 -0.17" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- ArUco Marker Plate on Roof (DICT_4X4_50, ID 0) -->
  <link name="aruco_marker_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.15 0.005"/>
      </geometry>
      <material name="marker_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.15 0.005"/>
      </geometry>
    </collision>
  </link>

  <joint name="aruco_marker_joint" type="fixed">
    <parent link="base_link"/>
    <child link="aruco_marker_link"/>
    <origin xyz="0 0 0.1275" rpy="0 0 0"/>
  </joint>

</robot>
