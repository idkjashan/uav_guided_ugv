<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>road_survey</name>
  <version>0.1.0</version>
  <description>
    Stage 1 of the DRDO UAV-guided UGV solution: build a 2.5-D elevation map
    from the UAV's downward depth camera during a manually flown survey,
    classify road vs. not-road from slope / step / roughness, and publish the
    result as a Nav2-ready OccupancyGrid.
  </description>
  <maintainer email="jashanpreetsinghbrar01@gmail.com">jashan</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
