<?xml version="1.0"?>
<robot name="x500_depth_down">

  <!-- UAV Base link -->
  <link name="uav_base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.0291" ixy="0.0" ixz="0.0"
               iyy="0.0291" iyz="0.0"
               izz="0.0552"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.4 0.1"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.4 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- Rotor arms and rotors -->
  <link name="rotor_0">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.01"/>
      </geometry>
      <material name="rotor_blue">
        <color rgba="0.1 0.3 0.8 0.6"/>
      </material>
    </visual>
  </link>
  <joint name="rotor_0_joint" type="continuous">
    <parent link="uav_base_link"/>
    <child link="rotor_0"/>
    <origin xyz="0.174 -0.174 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="rotor_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.01"/>
      </geometry>
      <material name="rotor_black">
        <color rgba="0.1 0.1 0.1 0.6"/>
      </material>
    </visual>
  </link>
  <joint name="rotor_1_joint" type="continuous">
    <parent link="uav_base_link"/>
    <child link="rotor_1"/>
    <origin xyz="-0.174 0.174 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="rotor_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.01"/>
      </geometry>
      <material name="rotor_blue"/>
    </visual>
  </link>
  <joint name="rotor_2_joint" type="continuous">
    <parent link="uav_base_link"/>
    <child link="rotor_2"/>
    <origin xyz="0.174 0.174 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="rotor_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.01"/>
      </geometry>
      <material name="rotor_black"/>
    </visual>
  </link>
  <joint name="rotor_3_joint" type="continuous">
    <parent link="uav_base_link"/>
    <child link="rotor_3"/>
    <origin xyz="-0.174 -0.174 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- OakD-Lite Downward Depth Camera -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.09 0.03"/>
      </geometry>
      <material name="camera_silver">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.09 0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="uav_base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.12 0.03 0.242" rpy="0 1.57079632679 0"/>
  </joint>

  <!-- REP-103 Camera Optical Frame -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

</robot>
